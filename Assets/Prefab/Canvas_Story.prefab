  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC778\uAC04\uC744 \uBAB0\uB77D\uC2DC\uD0A4\uACE0 \uC2A4\uC2A4\uB85C\uB97C
    '\uC720\uB2DB'\uC774\uB77C \uBA85\uBA85\uD55C \uB85C\uBD07\uB4E4\uC774 \uC138\uC0C1\uC744
    \uC9C0\uBC30\uD55C \uC9C0 \uC218\uC2ED\uB144.\r\n\r\n\r\n\uC2E0\uCCB4\uC5D0 \uACB0\uD568\uC774\uB098
    \uB0B4\uBD80\uC5D0 \uC624\uB958\uAC00 \uC0DD\uACA8 \uB3D9\uC871\uC5D0\uAC8C '\uC5D0\uB7EC\uC774\uB4DC'\uB77C
    \uAD6C\uBD84\uB2F9\uD558\uACE0 \uBC84\uB824\uC9C4 \uC720\uB2DB, \uADF8\uB9AC\uACE0
    \uC0B4\uC544\uB0A8\uC740 \uC18C\uC218\uC758 \uC778\uAC04\uB4E4\uC774 \uACF5\uC874\uD558\uB294
    [\uACE0\uCCA0 \uD3D0\uAE30\uC7A5]\r\n\r\n\r\n\uB3C4\uC2DC\uC5D0 \uD558\uAE09
    \uC720\uB2DB\uC774 \uBD80\uC871\uD574\uC9C4 \uC720\uB2DB\uB4E4\uC740 \uD3D0\uAE30\uC7A5\uC5D0
    [\uAC80\uBB38\uC18C]\uB97C \uC124\uCE58\uD558\uAC8C \uB418\uACE0, \uC5D0\uB7EC\uC774\uB4DC\uB97C
    \uAC80\uBB38\uAD00\uC73C\uB85C \uBC30\uCE58\uD558\uC5EC \uC4F8\uB9CC\uD55C \uC5D0\uB7EC\uC774\uB4DC\uB97C
    \uC120\uBCC4\uD55C\uB2E4.\r\n\r\n\r\n\uC720\uB2DB\uC774 \uC81C\uC2DC\uD55C \uADFC\uB85C\uC870\uAC74\uC744
    \uC218\uD589\uD55C \uAC80\uBB38\uAD00, \uADF8\uB9AC\uACE0 \uC120\uBCC4\uC2EC\uC0AC\uC5D0
    \uD1B5\uACFC\uB41C \uC5D0\uB7EC\uC774\uB4DC\uB294 \uD558\uAE09 \uC720\uB2DB\uC73C\uB85C\uB098\uB9C8
    \uB3C4\uC2DC\uC5D0\uC11C \uC0B4\uAC8C \uB418\uACE0 \uC228\uC5B4 \uC0AC\uB294
    \uC18C\uC218\uC758 \uC778\uAC04\uB4E4\uB3C4 \uC5D0\uB7EC\uC774\uB4DC\uB85C \uC704\uC7A5\uD574
    \uAC80\uBB38\uB300\uC5D0 \uC624\uB974\uAE30\uB3C4 \uD55C\uB2E4.\r\n\r\n\r\n\uC5D0\uB7EC\uC774\uB4DC\uB85C
    \uD3D0\uAE30\uC7A5\uC744 \uB5A0\uB3CC\uB358 \uB2F9\uC2E0 \uC5ED\uC2DC \uAC80\uBB38\uAD00
    \uC73C\uB85C \uADFC\uBB34\uD558\uAC8C \uB418\uACE0 \uB3C4\uC2DC\uB85C \uAC08
    \uAE30\uD68C\uB97C \uB178\uB9B0\uB2E4.\r\n"
